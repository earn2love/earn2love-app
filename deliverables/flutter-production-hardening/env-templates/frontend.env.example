# Admin panel FRONTEND env template (Firebase WEB keys are client-safe/public,
# but the file itself is git-ignored; set these in your deploy env).
REACT_APP_BACKEND_URL=https://your-backend-url
REACT_APP_FIREBASE_API_KEY=REPLACE_ME
REACT_APP_FIREBASE_AUTH_DOMAIN=earn2love-app.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=earn2love-app
REACT_APP_FIREBASE_STORAGE_BUCKET=earn2love-app.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
REACT_APP_FIREBASE_APP_ID=REPLACE_ME
REACT_APP_WEBSITE_URL=https://earn2love.com
