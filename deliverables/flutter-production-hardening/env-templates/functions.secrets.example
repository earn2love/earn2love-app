# Cloud Functions secrets (set via Firebase, NEVER commit real values)
# firebase functions:secrets:set STRIPE_SECRET_KEY
# firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# firebase functions:secrets:set AGORA_APP_ID
# firebase functions:secrets:set AGORA_APP_CERTIFICATE

STRIPE_SECRET_KEY=sk_live_xxx_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_xxx_REPLACE_ME
AGORA_APP_ID=xxx_REPLACE_ME
AGORA_APP_CERTIFICATE=xxx_REPLACE_ME

# Runtime flags (default OFF / safe)
ALLOW_DEV_STRIPE_CONFIRM=false
ADS_REWARD_ENABLED=false
AUTO_PAYOUT_ENABLED=false
