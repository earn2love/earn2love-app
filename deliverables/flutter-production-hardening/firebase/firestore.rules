rules_version = '2';

// ===========================================================================
// Earn2Love Firestore security rules.
// Principle: the CLIENT may never write server-managed money/state fields.
// Balances, tier, subscription, account status, verification and reports are
// written ONLY by Cloud Functions (Admin SDK bypasses these rules).
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role in
        ['super_admin', 'moderator', 'support_agent', 'finance_admin', 'verification_agent'];
    }
    // Fields on users/{uid} that only the server (Cloud Functions / Admin SDK) may change.
    function protectedUserFields() {
      return [
        'silverBalance', 'goldBalance', 'diamondBalance', 'lockedDiamond',
        'silverCoins', 'goldCoins', 'diamondCoins',
        'tier', 'subscriptionStatus', 'subscriptionPlan', 'subscriptionActivatedAt',
        'accountStatus', 'banned', 'frozen', 'walletFrozen',
        'reportsCount', 'verificationStatus', 'livenessVerifiedAt', 'livenessRequired',
        'pendingWithdrawalId', 'streakBonusPct', 'streakDays', 'lastConversionAt',
        'autoFrozenAt', 'forceLogoutAt'
      ];
    }
    function notTouchingProtected() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(protectedUserFields());
    }
    function chatParticipant(roomData) {
      return isSignedIn() && request.auth.uid in roomData.participants;
    }

    // ---- Users ------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      // Create own doc, but never seed protected money/state fields from client.
      allow create: if isOwner(uid)
        && !request.resource.data.diff({}).affectedKeys().hasAny(protectedUserFields());
      // Update own profile fields only; protected fields are server-managed.
      allow update: if (isOwner(uid) && notTouchingProtected()) || isAdmin();
      allow delete: if isAdmin();

      // Wallet history: owner + admin read; writes are server-only.
      match /walletHistory/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
      // Notifications: owner reads; server writes (owner may mark read).
      match /notifications/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid);
        allow create, delete: if isAdmin();
      }
      // Media (photos/videos): owner writes; signed-in users read eligible media.
      match /media/{mediaId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(uid);
      }
      // Per-user subcollections owned by the user.
      match /chatPrefs/{docId}     { allow read: if isOwner(uid) || isAdmin(); allow write: if isOwner(uid); }
      match /blockedUsers/{docId}  { allow read: if isOwner(uid) || isAdmin(); allow write: if isOwner(uid); }
      match /blocks/{docId}        { allow read: if isOwner(uid) || isAdmin(); allow write: if isOwner(uid); }
      match /following/{docId}     { allow read: if isSignedIn(); allow write: if isOwner(uid); }
      match /followers/{docId}     { allow read: if isSignedIn(); allow write: if isSignedIn(); }
      match /likes/{docId}         { allow read: if isSignedIn(); allow write: if isOwner(uid); }
      match /requests/{docId}      { allow read: if isOwner(uid) || isAdmin(); allow write: if isOwner(uid); }
      match /tmp/{docId}           { allow read, write: if isOwner(uid); }
      match /limits/{docId}        { allow read: if isOwner(uid) || isAdmin(); allow write: if false; }
    }

    // ---- Chat rooms -------------------------------------------------------
    match /chatRooms/{roomId} {
      allow read: if chatParticipant(resource.data) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if chatParticipant(resource.data);
      allow delete: if isAdmin();
      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn();
      }
    }
    match /chats/{roomId} {
      allow read: if chatParticipant(resource.data) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if chatParticipant(resource.data);
      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn();
      }
    }

    // ---- Connection requests ---------------------------------------------
    match /friendRequests/{reqId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid);
      allow delete: if isAdmin();
    }
    match /requests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isSignedIn();
    }

    // ---- Reports (safety) — restricted read -------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ---- Support tickets --------------------------------------------------
    match /supportTickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
    }

    // ---- Verification requests — sensitive; server + admin only -----------
    match /verificationRequests/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---- Server-only collections -----------------------------------------
    match /paymentIntents/{id}   { allow read: if isOwner(resource.data.uid) || isAdmin(); allow write: if false; }
    match /walletTransactions/{id} { allow read: if isOwner(resource.data.uid) || isAdmin(); allow write: if false; }
    match /stripeEvents/{id}     { allow read, write: if false; }
    match /calls/{id}            { allow read: if isSignedIn() && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid) || isAdmin(); allow write: if false; }
    match /adminAuditLogs/{id}   { allow read: if isAdmin(); allow write: if false; }

    // ---- Play Together game platform -------------------------------------
    // Game catalog + content: readable by signed-in clients (the mobile app
    // renders the catalog); ONLY admins/Cloud Functions may write.
    // NOTE: trivia "correct" answers live in gameContent; if you prefer to hide
    // them from clients entirely, restrict reads to isAdmin() and rely on the
    // server-written session public state (which never exposes answers).
    match /games/{gameId}        { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /gameContent/{id}      { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // Authoritative game sessions: FastAPI (Admin SDK) is the ONLY writer.
    // Participants may READ the public session document; the private
    // subcollection (hidden answers / un-revealed picks) is denied to clients.
    match /gameSessions/{sid} {
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid in resource.data.participantIds);
      allow write: if false;                       // server-only
      match /private/{doc} { allow read, write: if false; }   // hidden state
    }

    // Analytics events + sandbox previews: server-only.
    match /gameEvents/{id}          { allow read: if isAdmin(); allow write: if false; }
    match /gamePreviewSessions/{id} { allow read, write: if false; }

    // ---- Advanced AI Character Engine -----------------------------------
    // Character catalog: signed-in clients may READ (to render AI profiles);
    // ONLY admins/backend may write. All AI profiles are labelled isAi:true.
    match /aiCharacters/{cid}        { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /aiCharacterVersions/{id}  { allow read: if isAdmin();    allow write: if false; }
    // Per-user memory / conversations / relationship / metrics / evaluations:
    // backend-authoritative. Clients never write engine state and read their own
    // conversation via the backend API, not by querying these directly.
    match /aiCharacterMemories/{id}           { allow read: if isAdmin(); allow write: if false; }
    match /aiCharacterRelationshipState/{id}  { allow read: if isAdmin(); allow write: if false; }
    match /aiCharacterConversations/{id} {
      allow read: if isAdmin(); allow write: if false;
      match /turns/{t} { allow read: if isAdmin(); allow write: if false; }
    }
    match /aiCharacterMetrics/{id}     { allow read: if isAdmin(); allow write: if false; }
    match /aiCharacterEvaluations/{id} { allow read: if isAdmin(); allow write: if false; }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
